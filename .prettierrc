{
  "printWidth": 100,
  "tabWidth": 4,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "es5",
  "bracketSameLine": false,
  "plugins": [
    "prettier-plugin-blade"
  ],
  "overrides": [
    {
      "files": "**/*.blade.php",
      "options": {
        "parser": "blade",
        "htmlWhitespaceSensitivity": "ignore"
      }
    }
  ]
}
